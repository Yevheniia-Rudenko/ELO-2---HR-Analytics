# Environment variables for GCP deployment
# Copy this file to .env and fill in your values

# GCP Project Configuration
# Get these from: https://console.cloud.google.com
GCP_PROJECT_ID=your-test-project-id
GCP_PROJECT_NUMBER=123456789012
GCP_DATASET=TestDataset
GCP_TABLE=test_table

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# CORS Configuration
CORS_ORIGINS=https://yevheniia-rudenko.github.io,https://your-custom-domain.com

# Port (Cloud Run uses 8080 by default)
PORT=8080
