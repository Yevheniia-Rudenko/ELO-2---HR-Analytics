# Environment variables for GCP deployment
# Copy this file to .env and fill in your values

# GCP Project Configuration
GCP_PROJECT_ID=your-project-id-here
GCP_DATASET=IBMAnalytics
GCP_TABLE=employee_attrition

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# CORS Configuration
CORS_ORIGINS=https://yevheniia-rudenko.github.io,https://your-custom-domain.com

# Port (Cloud Run uses 8080 by default)
PORT=8080
